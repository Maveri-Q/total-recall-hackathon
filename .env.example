# Copy this file to .env.local and fill in your own values.
# Never commit .env.local. Never paste these values into chat.

# Supabase (database + email login) — Project Settings > API Keys
# Uses the new publishable/secret keys (the old anon/service_role keys are being retired end of 2026).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Secret key skips all database security rules. Server-side only, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Tatum (Sui gRPC gateway + Prediction Markets API)
TATUM_API_KEY=your-tatum-api-key
TATUM_SUI_GRPC_URL=https://sui-mainnet-grpc.gateway.tatum.io

# App wallet on Sui Mainnet (pays gas for every stamp). Server-side only.
SUI_APP_PRIVATE_KEY=suiprivkey-your-app-wallet-key
SUI_PACKAGE_ID=0x-your-published-move-package-id

# Walrus Memory (MemWal) — from https://memory.walrus.xyz/dashboard
MEMWAL_DELEGATE_KEY=your-delegate-key-hex
MEMWAL_ACCOUNT_ID=your-account-id
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Bookmaker odds — The Odds API
ODDS_API_KEY=your-odds-api-key

# Football results — football-data.org
FOOTBALL_DATA_API_KEY=your-football-data-key
